# At least one provider key is required to run H1–H4 (`pnpm eval` or the page's eval button).
# H5 is a unit test and does not need a key.
# Do not commit real values.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_GATEWAY_API_KEY=

# Optional custom API bases (no trailing slash required).
# The SDKs append /chat/completions, /responses, or /messages.
# Use a base that already includes /v1, e.g. https://api.example.test/v1
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
# Aliases accepted by this demo if the OPENAI_/ANTHROPIC_ names are unset:
CR_OPENAI_BASE_URL=
CR_ANTHROPIC_BASE_URL=
# Set to 1 to skip the OpenAI Responses path (e.g. when the compatible API
# only supports Chat Completions).
EVAL_SKIP_OPENAI=

# Optional model overrides. Defaults match current official docs as of 2026-11-17:
#   Anthropic: Claude Sonnet 5.5 (minimum cacheable length 512 tokens)
#   OpenAI Responses: gpt-5.6-sol (minimum cacheable length 1,024 tokens; supports prompt_cache_options)
#   Gateway: anthropic/claude-sonnet-5-5 (used only when no direct provider key is set)
ANTHROPIC_MODEL=
OPENAI_MODEL=
GATEWAY_MODEL=

# Optional eval knobs
# MAX_OUTPUT_TOKENS=16
# TARGET_PREFIX_TOKENS=2048
# EVAL_PREWARM=0
