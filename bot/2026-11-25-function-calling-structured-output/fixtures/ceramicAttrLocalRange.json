{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "form": {
      "type": "string",
      "description": "德化陶瓷器型"
    },
    "glaze": {
      "type": [
        "string",
        "null"
      ]
    },
    "capacityMl": {
      "type": "integer",
      "description": "容量（毫升）"
    },
    "uses": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "茶饮",
          "陈设",
          "餐饮"
        ]
      }
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "heightMm": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "heightMm"
      ],
      "additionalProperties": false
    },
    "painted": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "quantity": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "form",
    "glaze",
    "capacityMl",
    "uses",
    "dimensions",
    "painted",
    "quantity"
  ],
  "additionalProperties": false
}
